{
  "id": "vaccination",
  "version": "1.0.0",
  "apiVersion": "2.0",
  "entry": "dist/entry.js",
  "assets": {
    "styles": [
      "./dist/assets/tailwind.css",
      "./dist/assets/fontawesome/css/all.min.css"
    ]
  },
  "contributes": {
    "menus": [
      {
        "path": "Vacunación",
        "order": 3,
        "icon": "assets/icons/syringe.svg",
        "color": "#10B981"
      },
      {
        "path": "Vacunación/Vacunas",
        "order": 1,
        "viewId": "vaccination.catalogo.open"
      },
      {
        "path": "Vacunación/Aplicadas",
        "order": 3,
        "viewId": "vaccination.aplicadas.open"
      },
      {
        "path": "Vacunación/Próximas dosis",
        "order": 4,
        "viewId": "vaccination.proximas-dosis.open"
      }
    ],
    "views": [
      {
        "id": "vaccination.catalogo.open",
        "title": "Vacunas",
        "component": "./dist/views/catalogo/index.js",
        "export": "CatalogoView"
      },
      {
        "id": "vaccination.aplicadas.open",
        "title": "Aplicadas",
        "component": "./dist/views/aplicadas/index.js",
        "export": "AplicadasView"
      },
      {
        "id": "vaccination.proximas-dosis.open",
        "title": "Próximas dosis",
        "component": "./dist/views/proximas-dosis/index.js",
        "export": "ProximasDosisView"
      }
    ],
    "repositories": [
      {
        "module": "./dist/repositories/vaccine-detail.repository.js",
        "export": "VaccineDetailRepository",
        "prefix": "vaccination.catalog"
      },
      {
        "module": "./dist/repositories/vaccine-component.repository.js",
        "export": "VaccineComponentRepository",
        "prefix": "vaccination.components"
      },
      {
        "module": "./dist/repositories/applied-vaccination.repository.js",
        "export": "AppliedVaccinationRepository",
        "prefix": "vaccination.applied"
      }
    ],
    "viewContributions": [
      {
        "targetViewId": "patients.detail.open",
        "slot": "sections",
        "component": "./dist/contributions/vaccination-section/index.js",
        "export": "VaccinationSection",
        "order": 35,
        "label": "Vacunación",
        "icon": "Syringe"
      },
      {
        "targetViewId": "consultations.form.open",
        "slot": "sections",
        "component": "./dist/contributions/consultation-vaccines-section/index.js",
        "export": "ConsultationVaccinesSection",
        "order": 45,
        "label": "Vacunas"
      }
    ],
    "settings": {
      "groups": [{ "id": "vaccination", "label": "Vacunación", "order": 50 }],
      "pages": [
        {
          "id": "vaccination.general",
          "group": "vaccination",
          "label": "Próximas dosis",
          "icon": "assets/icons/syringe.svg",
          "order": 10
        }
      ],
      "sections": [
        {
          "id": "vaccination.general.main",
          "page": "vaccination.general",
          "label": "General",
          "order": 10,
          "items": [
            {
              "key": "vaccination.nextDoseAppointment",
              "type": "enum",
              "label": "Turno para próxima dosis",
              "description": "Al registrar una vacunación, controla si se ofrece agendar el turno de la próxima dosis automáticamente.",
              "default": "ask",
              "options": [
                { "value": "off", "label": "No agendar" },
                { "value": "ask", "label": "Preguntar" },
                { "value": "auto", "label": "Agendar automáticamente" }
              ],
              "tags": [
                "vaccination",
                "nextdoseappointment",
                "turno",
                "próxima",
                "dosis"
              ]
            }
          ]
        }
      ]
    }
  }
}
